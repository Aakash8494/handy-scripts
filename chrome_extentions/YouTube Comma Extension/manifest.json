{
    "manifest_version": 3,
    "name": "YouTube 2.5s Seek",
    "version": "1.1",
    "description": "Press the Left or Right Arrow keys to jump 2.5 seconds instead of 5.",
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}